{
  "name": "cline-orchestrator",
  "version": "0.1.0",
  "description": "Programmatic AI agent pipeline for software development using Cline CLI",
  "main": "dist/orchestrator.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/orchestrator.js",
    "process-ticket": "node dist/orchestrator.js process",
    "process-all": "node dist/orchestrator.js process-all",
    "init-tickets": "node dist/orchestrator.js init",
    "dev": "ts-node src/orchestrator.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "cline",
    "ai-agent",
    "orchestrator",
    "automation"
  ],
  "license": "MIT",
